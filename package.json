    "check:auth-guards": "bash scripts/check-auth-guards.sh",
    "check:i18n-parity": "node scripts/check-i18n-parity.mjs",
    "check:concurrency": "bun run scripts/concurrency-check.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
